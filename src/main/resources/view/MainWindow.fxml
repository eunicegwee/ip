<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity"
            minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="600.0" prefWidth="400.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="kira.gui.MainWindow">
    <children>
        <Label fx:id="headerLabel" text="Kira" styleClass="header" AnchorPane.topAnchor="6.0" AnchorPane.leftAnchor="12.0" />
        <ScrollPane fx:id="scrollPane"
                    hbarPolicy="NEVER"
                    hvalue="1.0"
                    AnchorPane.topAnchor="40.0"
                    AnchorPane.bottomAnchor="60.0"
                    AnchorPane.leftAnchor="8.0"
                    AnchorPane.rightAnchor="8.0"
                    vvalue="1.0">
            <content>
                <VBox fx:id="dialogContainer"
                      spacing="8.0"
                      prefWidth="388.0" />
            </content>
        </ScrollPane>
        <HBox spacing="6.0" AnchorPane.leftAnchor="8.0" AnchorPane.rightAnchor="8.0" AnchorPane.bottomAnchor="8.0">
            <children>
                <TextField fx:id="userInput"
                           onAction="#handleUserInput"
                           prefHeight="36.0"
                           HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton"
                        mnemonicParsing="false"
                        onAction="#handleUserInput"
                        prefHeight="36.0"
                        prefWidth="80.0"
                        text="Send" />
            </children>
        </HBox>
    </children>
</AnchorPane>
